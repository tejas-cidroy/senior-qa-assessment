{
  "name": "wholecart-qa",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation for WholeCart 1.0 marketplace release",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "capture": "tsx scripts/capture-responses.ts",
    "load": "k6 run load/checkout-search.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
